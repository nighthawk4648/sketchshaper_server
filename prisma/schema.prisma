generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id         Int       @id @default(autoincrement())
  email      String    @unique(map: "email_UNIQUE")
  password   String
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  sessions   Session[]
}

model Session {
  id           Int       @id @default(autoincrement())
  token_hash   String    @unique @db.Char(64)
  kind         String    @db.VarChar(20)
  admin_id     Int?
  expires_at   DateTime
  created_at   DateTime  @default(now())
  ip           String?   @db.VarChar(45)
  user_agent   String?   @db.VarChar(255)
  site_user_id Int?
  admin        User?     @relation(fields: [admin_id], references: [id], onDelete: Cascade)
  site_user    SiteUser? @relation(fields: [site_user_id], references: [id], onDelete: Cascade)

  @@index([admin_id])
  @@index([site_user_id])
  @@index([expires_at])
}

model SiteUser {
  id                Int          @id @default(autoincrement())
  email             String       @unique @db.VarChar(254)
  password          String?      @db.VarChar(100)
  name              String?      @db.VarChar(100)
  email_verified_at DateTime?
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt
  google_id         String?      @unique @db.VarChar(64)
  access            SiteAccess   @default(normal)
  access_note       String?      @db.VarChar(255)
  access_until      DateTime?
  email_tokens      EmailToken[]
  patreon_link      PatreonLink?
  sessions          Session[]
}

model PatreonLink {
  id                  Int      @id @default(autoincrement())
  site_user_id        Int      @unique
  patreon_id          String   @unique @db.VarChar(64)
  access_token_enc    String   @db.Text
  refresh_token_enc   String   @db.Text
  token_expires_at    DateTime
  membership_tier     String?  @db.VarChar(100)
  is_active_patron    Boolean  @default(false)
  pledge_amount_cents Int      @default(0)
  last_verified_at    DateTime @default(now())
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  site_user           SiteUser @relation(fields: [site_user_id], references: [id], onDelete: Cascade)
}

model EmailToken {
  id           Int       @id @default(autoincrement())
  token_hash   String    @unique @db.Char(64)
  type         String    @db.VarChar(20)
  site_user_id Int
  expires_at   DateTime
  used_at      DateTime?
  created_at   DateTime  @default(now())
  site_user    SiteUser  @relation(fields: [site_user_id], references: [id], onDelete: Cascade)

  @@index([site_user_id, type])
}

model ContactMessage {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(100)
  email           String   @db.VarChar(254)
  message         String   @db.LongText
  status          String   @default("NEW") @db.VarChar(20)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  attachment_file String?  @db.VarChar(255)
  attachment_mime String?  @db.VarChar(100)
  attachment_name String?  @db.VarChar(255)
  attachment_size Int?
  custom_scope    String?  @db.VarChar(255)
  phone           String?  @db.VarChar(30)
  reference_url   String?  @db.VarChar(2048)
  service_scope   String?  @db.VarChar(150)
  service_type    String?  @db.VarChar(30)

  @@index([status])
  @@index([created_at])
  @@index([service_type])
}

model Category {
  id                Int           @id @default(autoincrement())
  name              String
  short_description String        @db.LongText
  image             String?
  created_at        DateTime      @default(now())
  meta_description  String?       @db.LongText
  meta_title        String?
  updated_at        DateTime      @updatedAt
  keywords          String?       @db.LongText
  slug              String?       @unique
  sub_categories    SubCategory[]
}

model SubCategory {
  id                Int      @id @default(autoincrement())
  name              String
  short_description String   @db.LongText
  image             String?
  category_id       Int
  created_at        DateTime @default(now())
  meta_description  String?  @db.LongText
  meta_title        String?
  updated_at        DateTime @updatedAt
  keywords          String?  @db.LongText
  slug              String?
  assets            Asset[]
  category          Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@index([category_id], map: "SubCategory_category_id_fkey")
}

model Asset {
  id                Int             @id @default(autoincrement())
  name              String
  cover             String
  resolution        String
  size              String
  download_link     String?
  short_description String?         @db.LongText
  sub_category_id   Int
  created_at        DateTime        @default(now())
  meta_description  String?         @db.LongText
  meta_title        String?
  updated_at        DateTime        @updatedAt
  access_type       String          @default("free")
  cover_alt         String?         @db.Text
  keywords          String?         @db.LongText
  slug              String?
  sub_category      SubCategory     @relation(fields: [sub_category_id], references: [id], onDelete: Cascade)
  file              AssetFile?
  images            AssetImage[]
  child_relations   AssetRelation[] @relation("ChildAssetRelations")
  parent_relations  AssetRelation[] @relation("ParentAssetRelations")
  blog_assets       BlogAsset[]

  @@index([access_type])
  @@index([sub_category_id])
}

model AssetRelation {
  id              Int      @id @default(autoincrement())
  parent_asset_id Int
  child_asset_id  Int
  position        Int      @default(0)
  created_at      DateTime @default(now())
  child_asset     Asset    @relation("ChildAssetRelations", fields: [child_asset_id], references: [id], onDelete: Cascade)
  parent_asset    Asset    @relation("ParentAssetRelations", fields: [parent_asset_id], references: [id], onDelete: Cascade)

  @@unique([parent_asset_id, child_asset_id])
  @@index([parent_asset_id])
  @@index([child_asset_id])
}

model BlogAsset {
  id         Int      @id @default(autoincrement())
  blog_id    Int
  asset_id   Int
  position   Int      @default(0)
  created_at DateTime @default(now())
  asset      Asset    @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  blog       Blog     @relation(fields: [blog_id], references: [id], onDelete: Cascade)

  @@unique([blog_id, asset_id])
  @@index([blog_id])
  @@index([asset_id])
}

model AssetImage {
  id         Int      @id @default(autoincrement())
  image      String
  asset_id   Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  alt        String?  @db.Text
  asset      Asset    @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@index([asset_id], map: "AssetImage_asset_id_fkey")
}

model AssetFile {
  id                Int      @id @default(autoincrement())
  asset_id          Int      @unique
  main_file         String   @default("")
  file_type         String   @default("")
  file_size         BigInt   @default(0)
  upload_status     String   @default("pending")
  upload_progress   Float    @default(0)
  uploaded_chunks   Int      @default(0)
  total_chunks      Int      @default(0)
  chunk_size        Int      @default(5242880)
  upload_session_id String?  @unique
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  asset             Asset    @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@index([upload_status])
}

model AboutUs {
  id                Int      @id @default(autoincrement())
  slug              String   @unique
  title             String
  cover             String
  short_description String   @db.LongText
  content           String   @db.LongText
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
}

model Setting {
  id               Int      @id @default(autoincrement())
  slug             String   @unique
  site_name        String
  site_description String   @db.LongText
  site_logo        String
  site_favicon     String
  site_email       String
  site_phone       String
  site_address     String
  site_footer      String
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
}

model Page {
  id                Int      @id @default(autoincrement())
  slug              String   @unique
  title             String
  cover             String
  short_description String
  content           String   @db.LongText
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  keywords          String?  @db.LongText
  meta_description  String?  @db.LongText
  meta_title        String?
}

model Slider {
  id                Int      @id @default(autoincrement())
  name              String
  logo              String
  short_description String   @db.LongText
  image             String
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
}

model Social {
  id         Int      @id @default(autoincrement())
  name       String
  url        String
  icon       String
  order      Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model InnovativeFurnitures {
  id                Int      @id @default(autoincrement())
  title             String
  short_description String
  urlOne            String
  urlTwo            String
  urlThree          String
  urlFour           String
  bgImg             String
  order             Int      @default(0)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
}

model SupportedBy {
  id                Int      @id @default(autoincrement())
  title             String
  short_description String
  imageOne          String
  imageTwo          String
  imageThree        String
  imageFour         String
  imageFive         String
  order             Int      @default(0)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
}

model Blog {
  id                Int         @id @default(autoincrement())
  title             String
  name              String
  short_description String      @db.LongText
  image             String
  bgImage           String
  order             Int         @default(0)
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt
  back_link         String
  paragraph_one     String      @db.LongText
  paragraph_three   String      @db.LongText
  paragraph_two     String      @db.LongText
  image_alt         String?     @db.Text
  bg_image_alt      String?     @db.Text
  keywords          String?     @db.LongText
  meta_description  String?     @db.LongText
  meta_title        String?
  slug              String?     @unique
  featured_assets   BlogAsset[]
}

model Gallery {
  id         Int      @id @default(autoincrement())
  image      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model PatreonUser {
  id                  Int      @id @default(autoincrement())
  patreon_id          String   @unique
  email               String   @unique
  full_name           String?
  access_token        String   @db.Text
  refresh_token       String   @db.Text
  token_expires_at    DateTime
  membership_tier     String?
  is_active_patron    Boolean  @default(false)
  pledge_amount_cents Int?
  last_verified_at    DateTime @default(now())
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
}

model ExtensionDownload {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  count      Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

enum SiteAccess {
  normal
  pro
  blocked
}
