// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique(map: "email_UNIQUE")
  password   String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model ContactMessage {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(100)
  email           String   @db.VarChar(254)
  phone           String?  @db.VarChar(30)
  service_type    String?  @db.VarChar(30)   // architecture | single-model | textures | extension | support
  service_scope   String?  @db.VarChar(150)
  custom_scope    String?  @db.VarChar(255)  // only when an "Other..." scope is chosen
  reference_url   String?  @db.VarChar(2048)
  attachment_file String?  @db.VarChar(255)  // stored random filename (never a public URL)
  attachment_name String?  @db.VarChar(255)  // original filename, for display/download
  attachment_mime String?  @db.VarChar(100)
  attachment_size Int?                       // bytes
  message         String   @db.LongText
  status          String   @default("NEW") @db.VarChar(20)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([status])
  @@index([created_at])
  @@index([service_type])
}

model Category {
  id                Int           @id @default(autoincrement())
  slug              String?       @unique
  name              String
  short_description String        @db.LongText
  image             String?
  sub_categories    SubCategory[]
  meta_title        String?
  meta_description  String?       @db.LongText
  keywords          String?       @db.LongText
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
}

model SubCategory {
  id                Int      @id @default(autoincrement())
  slug              String?
  name              String
  short_description String   @db.LongText
  image             String?
  category          Category @relation(fields: [category_id], references: [id], onDelete: Cascade)
  category_id       Int
  assets            Asset[]
  meta_title        String?
  meta_description  String?  @db.LongText
  keywords          String?  @db.LongText
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
}

model Asset {
  id                Int          @id @default(autoincrement())
  slug              String?
  name              String
  cover             String
  cover_alt         String?      @db.Text
  resolution        String
  size              String
  download_link     String?
  short_description String?      @db.LongText
  sub_category      SubCategory  @relation(fields: [sub_category_id], references: [id], onDelete: Cascade)
  sub_category_id   Int
  images            AssetImage[]
  file              AssetFile?
  access_type       String       @default("free")
  meta_title        String?
  meta_description  String?      @db.LongText
  keywords          String?      @db.LongText
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt

  parent_relations  AssetRelation[] @relation("ParentAssetRelations")
  child_relations   AssetRelation[] @relation("ChildAssetRelations")
  blog_assets       BlogAsset[]

  @@index([access_type])
  @@index([sub_category_id])
}

model AssetRelation {
  id              Int      @id @default(autoincrement())
  parent_asset_id Int
  child_asset_id  Int
  position        Int      @default(0)
  parent_asset    Asset    @relation("ParentAssetRelations", fields: [parent_asset_id], references: [id], onDelete: Cascade)
  child_asset     Asset    @relation("ChildAssetRelations", fields: [child_asset_id], references: [id], onDelete: Cascade)
  created_at      DateTime @default(now())

  @@unique([parent_asset_id, child_asset_id])
  @@index([parent_asset_id])
  @@index([child_asset_id])
}

model BlogAsset {
  id         Int      @id @default(autoincrement())
  blog_id    Int
  asset_id   Int
  position   Int      @default(0)
  blog       Blog     @relation(fields: [blog_id], references: [id], onDelete: Cascade)
  asset      Asset    @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())

  @@unique([blog_id, asset_id])
  @@index([blog_id])
  @@index([asset_id])
}

model AssetImage {
  id         Int      @id @default(autoincrement())
  image      String
  alt        String?  @db.Text
  asset_id   Int
  asset      Asset    @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model AssetFile {
  id                Int      @id @default(autoincrement())
  asset_id          Int      @unique
  asset             Asset    @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  main_file         String   @default("")
  file_type         String   @default("")
  file_size         BigInt   @default(0)
  upload_status     String   @default("pending")
  upload_progress   Float    @default(0)
  uploaded_chunks   Int      @default(0)
  total_chunks      Int      @default(0)
  chunk_size        Int      @default(5242880)
  upload_session_id String?  @unique
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@index([upload_status])
}

// Upload status enum values: 'pending', 'uploading', 'completed', 'failed'

model AboutUs {
  id                Int      @id @default(autoincrement())
  slug              String   @unique
  title             String
  cover             String
  short_description String   @db.LongText
  content           String   @db.LongText
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
}

model Setting {
  id               Int      @id @default(autoincrement())
  slug             String   @unique
  site_name        String
  site_description String   @db.LongText
  site_logo        String
  site_favicon     String
  site_email       String
  site_phone       String
  site_address     String
  site_footer      String
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
}

model Page {
  id                Int      @id @default(autoincrement())
  slug              String   @unique
  title             String
  cover             String
  short_description String
  content           String   @db.LongText
  meta_title        String?
  meta_description  String?  @db.LongText
  keywords          String?  @db.LongText
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
}

model Slider {
  id                Int      @id @default(autoincrement())
  name              String
  logo              String
  short_description String   @db.LongText
  image             String
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
}

model Social {
  id         Int      @id @default(autoincrement())
  name       String
  url        String
  icon       String
  order      Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model InnovativeFurnitures {
  id                Int      @id @default(autoincrement())
  title             String
  short_description String
  urlOne            String
  urlTwo            String
  urlThree          String
  urlFour           String
  bgImg             String
  order             Int      @default(0)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
}

model SupportedBy {
  id                Int      @id @default(autoincrement())
  title             String
  short_description String
  imageOne          String
  imageTwo          String
  imageThree        String
  imageFour         String
  imageFive         String
  order             Int      @default(0)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
}

model Blog {
  id                Int      @id @default(autoincrement())
  slug              String?  @unique
  title             String
  name              String
  short_description String   @db.LongText
  paragraph_one     String   @db.LongText
  paragraph_two     String   @db.LongText
  paragraph_three   String   @db.LongText
  image             String
  image_alt         String?  @db.Text
  bgImage           String
  bg_image_alt      String?  @db.Text
  back_link         String
  meta_title        String?
  meta_description  String?  @db.LongText
  keywords          String?  @db.LongText
  order             Int      @default(0)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  featured_assets   BlogAsset[]
}

model Gallery {
  id         Int      @id @default(autoincrement())
  image      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model PatreonUser {
  id                  Int      @id @default(autoincrement())
  patreon_id          String   @unique
  email               String   @unique
  full_name           String?
  access_token        String   @db.Text
  refresh_token       String   @db.Text
  token_expires_at    DateTime
  membership_tier     String?
  is_active_patron    Boolean  @default(false)
  pledge_amount_cents Int?
  last_verified_at    DateTime @default(now())
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
}



model ExtensionDownload {
  id         Int      @id @default(autoincrement())
  name       String // Extension name (e.g., "MyExtension", "SketchPlugin")
  count      Int      @default(0) // Total download count
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([name])
}
